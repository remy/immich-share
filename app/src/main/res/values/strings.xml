    <string name="result_server_error">The server answered with an error (HTTP %1$d).</string>
    <string name="result_unreachable">Couldn\'t reach the server: %1$s</string>

    <!-- Permissions -->
    <string name="permissions_title">Permissions</string>
    <string name="permissions_media_why">Immich Share needs media access so your photos keep their location when uploaded. Without it, Android removes the GPS data before this app ever sees the photo.</string>
    <string name="permissions_media_ok">Media access granted — location will be kept</string>
    <string name="permissions_media_missing">Media access missing — photos will lose their location</string>
    <string name="permissions_grant_media">Allow media access</string>
    <string name="permissions_notify_ok">Notifications allowed</string>
    <string name="permissions_notify_missing">Notifications off — you won\'t see upload progress</string>
    <string name="permissions_grant_notify">Allow notifications</string>
    <string name="permissions_open_settings">Open app settings</string>

    <!-- Help -->
    <string name="help_title">Getting set up</string>
    <string name="help_api_key">To make an API key: open Immich in a browser, go to Account Settings, then API Keys, and create a new one. Copy it into the box above.</string>
    <string name="help_sharing">Then share photos from any app — tap Share, pick Immich Share, and choose an album if you want one.</string>

