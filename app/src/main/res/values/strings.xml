    <!-- Settings screen -->
    <string name="settings_title">Immich Share</string>
    <string name="settings_intro">Send photos straight to your Immich server from any app\'s share button. Photos are uploaded exactly as they are, so dates, camera details and location are kept.</string>
    <string name="settings_server">Your Immich server</string>
    <string name="settings_host_label">Server address</string>
    <string name="settings_host_hint">photos.example.com</string>
    <string name="settings_host_help">If you leave off https:// it will be added for you.</string>
    <string name="settings_key_label">API key</string>
    <string name="settings_key_show">Show API key</string>
    <string name="settings_key_hide">Hide API key</string>
    <string name="settings_test">Save and test connection</string>
    <string name="settings_version">Version %1$s</string>

    <string name="result_connected">Connected as %1$s</string>
